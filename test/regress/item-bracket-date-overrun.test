; Regression test: a bracketed date directive whose contents overrun the
; fixed extraction buffer.
;
; item_t::parse_tags() copies the text between `[` and `]` into a 256-byte
; stack buffer with strncpy() before handing it to parse_date().  The copy
; length came straight from the comment, so a journal containing a long
; enough bracketed span smashed the stack: 600 padding characters tripped
; the stack protector, and 100,000 segfaulted outright.
;
; A span that long is obviously not a date, so it is now ignored and the
; item keeps its own date.

2026/01/01 * Overrun
    Expenses:Overrun                $100.00  ; []
    Assets:Checking

2026/01/02 * Overrun Effective
    Expenses:OverrunAux             $200.00  ; []
    Assets:Checking

test reg ^Expenses:Overrun or ^Expenses:OverrunAux
26-Jan-01 Overrun               Expenses:Overrun            $100.00      $100.00
26-Jan-02 Overrun Effective     Expenses:OverrunAux         $200.00      $300.00
end test

test reg --effective ^Expenses:Overrun or ^Expenses:OverrunAux
26-Jan-01 Overrun               Expenses:Overrun            $100.00      $100.00
26-Jan-02 Overrun Effective     Expenses:OverrunAux         $200.00      $300.00
end test
